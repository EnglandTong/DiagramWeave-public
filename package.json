{
  "name": "diagramweave",
  "version": "1.0.0",
  "description": "DiagramWeave - 单机 Web 流程图编辑器",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dep-graph": "node scripts/dep-graph.mjs",
    "hub": "node core-server/src/server.mjs",
    "hub:serve": "node core-server/src/server.mjs",
    "serve:legacy": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "electron": "electron .",
    "vendor:copy": "node scripts/copy-vendor.mjs",
    "font:download": "node scripts/download-font.mjs",
    "postinstall": "node scripts/copy-vendor.mjs && node scripts/download-font.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "typecheck": "node scripts/check-syntax.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node node_modules/eslint/bin/eslint.js . --fix",
    "format": "node node_modules/prettier/bin/prettier.cjs --write ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "dependencies": {
    "bpmn-moddle": "^10.0.0",
    "dagre": "^0.8.5",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "mermaid": "^11.16.0",
    "svg2pdf.js": "^2.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "electron": "^42.4.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.5",
    "vitest": "^3.2.6"
  }
}
